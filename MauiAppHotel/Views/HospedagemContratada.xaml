<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#E1E1E1">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20" Spacing="20">

        <Label Text="{Binding QuartoSelecionado.Descricao}"
               TextColor="#C62828"
               FontFamily="Kalam"
               FontSize="40"
               HorizontalTextAlignment="Center"/>

        <Frame Padding="20" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Adultos:" TextColor="Black" FontSize="16"/>
                    <Label Grid.Column="1" Text="{Binding QtdAdultos}" TextColor="#C62828" FontAttributes="Bold" FontSize="18"/>
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Crianças:" TextColor="Black" FontSize="16"/>
                    <Label Grid.Column="1" Text="{Binding QtdCriancas}" TextColor="#C62828" FontAttributes="Bold" FontSize="18"/>
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <Frame Padding="20" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="Gray" FontSize="12" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" TextColor="Gray" FontSize="12" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:" TextColor="Gray" FontSize="12" HorizontalTextAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Black" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Black" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia, StringFormat='{0} dias'}" TextColor="Black" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            </Grid>
        </Frame>

        <Frame Padding="20" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="Valor Total:" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding ValorTotal, StringFormat='{0:C}'}" TextColor="#C62828" FontAttributes="Bold" FontSize="20"/>
            </Grid>
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="#C62828"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50"
                Margin="0,20,0,0"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>