<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Sobre"
             Title="Sobre o Desenvolvedor"
             BackgroundColor="#E1E1E1">

    <VerticalStackLayout VerticalOptions="Center" Padding="20">

        <Frame Padding="25" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <VerticalStackLayout Spacing="15">

                <Label Text="🏨 Maui App Hotel"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#C62828"
                       HorizontalOptions="Center" />

                <Label Text="Sistema para estimativa e contratação de diárias de hospedagem."
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

                <Label Text="Desenvolvedor"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center" />

                <Label Text="Fabrício Franco"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center" />

                <Label Text="Ano de Desenvolvimento"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center" Margin="0,10,0,0" />

                <Label Text="2026"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>